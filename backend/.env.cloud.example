# Copy to backend/.env.cloud (ignored by Git) for the Modal Secret. Never commit real values.
SENTINEL_MODE=cloud
SENTINEL_FRONTEND_ORIGIN=https://sentinel-document-intelligence.vercel.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Copy the Session pooler connection string from Supabase > Connect (IPv4-compatible).
SUPABASE_DB_URL=postgresql://postgres.project-ref:replace-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
SENTINEL_STORAGE_BUCKET=sentinel-private
