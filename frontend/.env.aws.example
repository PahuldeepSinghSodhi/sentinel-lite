# Public frontend configuration for the active AWS-backed Vercel deployment.
# Replace placeholders with the corresponding deployed resources; never add secrets.
VITE_SENTINEL_MODE=cloud
VITE_CLOUD_PROVIDER=aws
VITE_API_BASE_URL=https://your-api-id.execute-api.ap-southeast-2.amazonaws.com
VITE_AWS_REGION=ap-southeast-2
VITE_COGNITO_USER_POOL_ID=ap-southeast-2_replace-with-pool-id
VITE_COGNITO_CLIENT_ID=replace-with-public-app-client-id
VITE_ENABLE_GOOGLE_AUTH=false
VITE_ENABLE_GITHUB_AUTH=false
