# Set these in Vercel project settings for the cloud deployment.
VITE_SENTINEL_MODE=cloud
VITE_API_BASE_URL=https://your-workspace--sentinel-cloud-api.modal.run
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
# Enable only after configuring the matching provider in Supabase Auth.
VITE_ENABLE_GOOGLE_AUTH=false
VITE_ENABLE_GITHUB_AUTH=false
